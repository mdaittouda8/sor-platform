# Copy this file to `.env` and fill in your SharePoint credentials.
# The backend (main.py) loads .env automatically via python-dotenv.

# --- SharePoint tenant & site ---
# Tenant short name — for https://oncf.sharepoint.com this is "oncf"
SP_TENANT=your-tenant-name

# Site name — the segment after /sites/ in the SharePoint URL
SP_SITE=your-site-name

# Azure AD app registration's Application (client) ID
SP_CLIENT_ID=

# --- ROPC credentials (username / password flow) ---
# Heads-up: ROPC is disabled for users with MFA. If your account has MFA, you'll need a
# service account without MFA, or switch to device-code flow (not yet wired up here).
SP_USERNAME=
SP_PASSWORD=

# --- File to download ---
# Server-relative path, starts with /sites/...
SP_FILE_PATH=/sites/your-site-name/Documents partages/General/your-file.xlsx

# --- Optional ---
# PORT=8000


# ============================================================================
# Expandium gold DB (read-only)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gsmr_dwh
DB_USER=optimrail_reader
DB_PASSWORD=
DB_SCHEMA_GOLD=gold

# ============================================================================
# Expandium pipeline script (for refresh button)
# ============================================================================
PIPELINE_SCRIPT_PATH=/path/to/gsmr-data-pipeline-dwh/scheduler.py
# Optional: explicit python venv to use for the pipeline (recommended)
# Adjust the path if your venv is elsewhere
PIPELINE_PYTHON=/path/to/gsmr-data-pipeline-dwh/.venv/Scripts/python.exe